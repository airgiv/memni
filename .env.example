# Мемме — example settings. Copy to .env.local and fill in. No secrets here.
# Without keys the app runs in DEMO mode (SQLite + files in .data/, labelled placeholders instead of generations).

APP_URL=http://localhost:3000
# Signs the session cookie. Generated automatically in demo (.data/session-secret); required in production.
SESSION_SECRET=

# ── Data: Supabase (Postgres + Auth + private Storage) ─────────────────
# Empty → local demo backend. All three keys → live data mode.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=memni-private
# DATA_BACKEND=local   # force the local backend even when keys are set

# ── Images: direct Gemini API (Google AI for Developers) ───────────────
IMAGE_PROVIDER=gemini          # or demo
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_COST_USD=0.067    # estimated cost of one image, for the usage ledger
GEMINI_TIMEOUT_MS=90000

# ── Photo checks (quality, face count, body visibility — never gender or identity) ──
PHOTO_ANALYZER=local           # local (pixel checks only) | gemini (uses GEMINI_API_KEY)
GEMINI_ANALYSIS_MODEL=gemini-3.1-flash

# ── Video: Kling (direct API), Genjutsu as an alternative ──────────────
VIDEO_PROVIDER=kling           # kling | genjutsu | demo
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_BASE_URL=https://api-singapore.klingai.com
KLING_MODEL=kling-v2-6
KLING_MODE=std
KLING_COST_USD_PER_SEC=
# Genjutsu Motion Transfer (Higgsfield): KEY_ID:KEY_SECRET
GENJUTSU_API_KEY=
# Provider callbacks (public HTTPS): https://<domain>/api/webhooks/video
VIDEO_WEBHOOK_URL=
# Public base URL from which the video service downloads meme media (if not APP_URL)
TEMPLATE_MEDIA_BASE_URL=

# ── Payments and prices ───────────────────────────────────────────────
# Server-selected payment adapter. Only "test" exists: nothing is charged.
PAYMENT_PROVIDER=test
# Billing country when the request has no explicit choice and no edge geo header
DEFAULT_BILLING_COUNTRY=US
# Prices live in src/lib/commerce/prices.ts (per currency); they are placeholders
PRICES_ARE_EXAMPLES=true
# Shared previews a user gets free (lifetime, not per draft)
FREE_PREVIEWS_PER_USER=1

# ── Limits ─────────────────────────────────────────────────────────────
MAX_ACTIVE_JOBS_PER_USER=1
MAX_ACTIVE_JOBS_GLOBAL=3
MAX_VIDEO_ATTEMPTS_PER_JOB=2
MAX_JOBS_PER_USER_PER_DAY=5
MAX_PHOTO_BYTES=12582912
# Allowed difference between generated video and original audio, seconds
DURATION_TOLERANCE_SEC=0.35

# ── Telegram Mini App ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_INITDATA_MAX_AGE=86400

# ── Worker ─────────────────────────────────────────────────────────────
# System ffmpeg/ffprobe instead of the npm binaries (recommended on servers)
FFMPEG_PATH=
FFPROBE_PATH=
LOCAL_DATA_DIR=.data
# Imported meme media (licensed, never in git); a volume in production
MEDIA_DIR=.media
# Enables /admin/media (upload + import of meme source videos on the server)
ADMIN_TOKEN=
