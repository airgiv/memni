# memni — пример настроек. Скопируйте в .env.local и заполните. Секретов здесь нет.
# Без ключей приложение запускается в ДЕМО-режиме (SQLite + файлы в .data/, примеры вместо генераций).

APP_URL=http://localhost:3000
# Подпись сессионной cookie. В демо создаётся автоматически в .data/session-secret; в продакшене обязательно.
SESSION_SECRET=

# ── Данные: Supabase (Postgres + Auth + приватное Storage) ─────────────
# Пусто → локальный демо-бэкенд. Все три ключа → реальный режим данных.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=memni-private
# DATA_BACKEND=local   # принудительно локальный бэкенд даже при заданных ключах

# ── Изображения: прямой Gemini API (Google AI for Developers) ──────────
IMAGE_PROVIDER=gemini          # или demo
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Оценка стоимости одного изображения (USD) для учёта расходов, пока нет фактической
GEMINI_IMAGE_COST_USD=0.067
GEMINI_TIMEOUT_MS=90000

# ── Видео: Kling (прямой API), Genjutsu — альтернатива для сравнения ───
VIDEO_PROVIDER=kling           # kling | genjutsu | demo
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_BASE_URL=https://api-singapore.klingai.com
KLING_MODEL=kling-v2-6
KLING_MODE=std
KLING_COST_USD_PER_SEC=
# Genjutsu Motion Transfer (Higgsfield): ключ в формате KEY_ID:KEY_SECRET
GENJUTSU_API_KEY=
# Куда провайдер шлёт уведомления (должен быть публичный HTTPS): https://<домен>/api/webhooks/video
VIDEO_WEBHOOK_URL=
# Публичный адрес, по которому видеосервис скачает исходный ролик шаблона (если не APP_URL)
TEMPLATE_MEDIA_BASE_URL=

# ── Лимиты и бюджет ────────────────────────────────────────────────────
# ── Цены и предложение «первое превью бесплатно» ──────────────────────
# Сколько общих превью пользователь получает бесплатно (за всё время, а не за черновик)
FREE_PREVIEWS_PER_USER=1
# Цена каждого следующего превью, в копейках (4900 = 49 ₽)
PREVIEW_PRICE_MINOR=4900
# Цена видео; пусто → цена из шаблона (Hotel Lobby: 99 ₽ как пример)
VIDEO_PRICE_MINOR=
PRICE_CURRENCY=RUB
# Цены — примеры, пока не известны себестоимость и страна продавца
PRICES_ARE_EXAMPLES=true
MAX_ACTIVE_JOBS_PER_USER=1
MAX_ACTIVE_JOBS_GLOBAL=3
MAX_VIDEO_ATTEMPTS_PER_JOB=2
MAX_JOBS_PER_USER_PER_DAY=5
MAX_PHOTO_BYTES=12582912
# Допустимое расхождение длительности видео и оригинального звука, секунд
DURATION_TOLERANCE_SEC=0.35

# ── Telegram Mini App ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_INITDATA_MAX_AGE=86400

# ── Фоновый обработчик ────────────────────────────────────────────────
# Системные ffmpeg/ffprobe вместо npm-бинарников (рекомендуется на сервере)
FFMPEG_PATH=
FFPROBE_PATH=
LOCAL_DATA_DIR=.data
